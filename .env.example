# ==============================================================================
# NEXORA Environment Variables Template
# ==============================================================================
# This file serves as a reference for required and optional environment variables.
# Copy this file to `.env.local` for local development. Never commit sensitive secrets.
#
# NOTE ON VARIABLE EXPOSURE IN NEXT.JS:
# - Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser/client bundles.
# - All other variables are STRICTLY SERVER-ONLY and never leaked to the client.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server-Only Configuration
# ------------------------------------------------------------------------------
# Base Node environment (development, production, test)
NODE_ENV=development

# Application base URL used for server-side resolution, webhooks, or callbacks
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# AI Provider Configuration (Server-Only)
# Supported options (Set ANY one of these to activate AI Copilot):
# ------------------------------------------------------------------------------
# 1. Groq (100% Free, ultra-fast Llama 3.3 70B, recommended) -> https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini Free Tier -> https://aistudio.google.com
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# 3. OpenRouter -> https://openrouter.ai
# OPENROUTER_API_KEY=

# 4. OpenAI -> https://platform.openai.com
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Client-Exposed Configuration (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Publicly visible application URL (accessible in browser client components)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application environment identifier visible to the client (e.g. development, staging, production)
NEXT_PUBLIC_APP_ENV=development

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Public Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
